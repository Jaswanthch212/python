class Solution:
    def processStr(self, s, k):
        n = len(s)

        lengths = [0] * (n + 1)

        for i, ch in enumerate(s):
            cur = lengths[i]

            if 'a' <= ch <= 'z':
                lengths[i + 1] = cur + 1
            elif ch == '*':
                lengths[i + 1] = max(0, cur - 1)
            elif ch == '#':
                lengths[i + 1] = min(10**18, cur * 2)
            else:
                lengths[i + 1] = cur

        if k >= lengths[n]:
            return '.'

        for i in range(n - 1, -1, -1):
            ch = s[i]

            if 'a' <= ch <= 'z':
                if k == lengths[i]:
                    return ch

            elif ch == '*':
                k += 1

            elif ch == '#':
                prev = lengths[i]
                if k >= prev:
                    k -= prev

            else:
                k = lengths[i] - 1 - k

        return '.'
