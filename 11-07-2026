from collections import deque

class Solution:
    def countCompleteComponents(self, n, edges):
        graph = [[] for _ in range(n)]

        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)

        visited = [False] * n
        ans = 0

        for i in range(n):
            if visited[i]:
                continue

            q = deque([i])
            visited[i] = True
            nodes = []

            while q:
                u = q.popleft()
                nodes.append(u)

                for v in graph[u]:
                    if not visited[v]:
                        visited[v] = True
                        q.append(v)

            size = len(nodes)
            edgeCount = 0

            for u in nodes:
                edgeCount += len(graph[u])

            edgeCount //= 2

            if edgeCount == size * (size - 1) // 2:
                ans += 1

        return ans
