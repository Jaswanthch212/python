import heapq
from math import log2

class Solution:
    def maxTotalValue(self, nums, k):
        n = len(nums)

        lg = int(log2(n)) + 1

        mx = [[0] * n for _ in range(lg)]
        mn = [[0] * n for _ in range(lg)]

        for i in range(n):
            mx[0][i] = nums[i]
            mn[0][i] = nums[i]

        j = 1
        while (1 << j) <= n:
            length = 1 << j
            half = length >> 1

            for i in range(n - length + 1):
                mx[j][i] = max(mx[j - 1][i], mx[j - 1][i + half])
                mn[j][i] = min(mn[j - 1][i], mn[j - 1][i + half])

            j += 1

        def value(l, r):
            length = r - l + 1
            p = int(log2(length))

            maximum = max(mx[p][l], mx[p][r - (1 << p) + 1])
            minimum = min(mn[p][l], mn[p][r - (1 << p) + 1])

            return maximum - minimum

        heap = []

        for l in range(n):
            v = value(l, n - 1)
            heapq.heappush(heap, (-v, l, n - 1))

        ans = 0

        for _ in range(k):
            negv, l, r = heapq.heappop(heap)

            ans += -negv

            if r > l:
                nv = value(l, r - 1)
                heapq.heappush(heap, (-nv, l, r - 1))

        return ans
