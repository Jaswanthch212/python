class Solution:
    def zigZagArrays(self, n, l, r):
        MOD = 10**9 + 7

        m = r - l + 1

        up = [0] * m
        down = [0] * m

        for i in range(m):
            up[i] = 1
            down[i] = 1

        for _ in range(2, n):
            new_up = [0] * m
            new_down = [0] * m

            prefix_up = [0] * (m + 1)
            prefix_down = [0] * (m + 1)

            for i in range(m):
                prefix_up[i + 1] = (prefix_up[i] + up[i]) % MOD
                prefix_down[i + 1] = (prefix_down[i] + down[i]) % MOD

            total_up = prefix_up[m]
            total_down = prefix_down[m]

            for i in range(m):
                new_up[i] = prefix_down[i] % MOD
                new_down[i] = (total_up - prefix_up[i + 1]) % MOD

            up = new_up
            down = new_down

        ans = (sum(up) + sum(down)) % MOD
        return ans
