from collections import Counter
from bisect import bisect_right

class Solution:
    def gcdValues(self, nums, queries):
        mx = max(nums)
        freq = Counter(nums)

        cnt = [0] * (mx + 1)
        for x, c in freq.items():
            cnt[x] = c

        mult = [0] * (mx + 1)
        for g in range(1, mx + 1):
            s = 0
            for j in range(g, mx + 1, g):
                s += cnt[j]
            mult[g] = s

        pairs = [0] * (mx + 1)
        for g in range(mx, 0, -1):
            c = mult[g]
            total = c * (c - 1) // 2
            j = 2 * g
            while j <= mx:
                total -= pairs[j]
                j += g
            pairs[g] = total

        pref = []
        vals = []
        cur = 0
        for g in range(1, mx + 1):
            if pairs[g]:
                cur += pairs[g]
                vals.append(g)
                pref.append(cur)

        ans = []
        for q in queries:
            ans.append(vals[bisect_right(pref, q)])
        return ans
